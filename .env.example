# Password for the dashboard login (required)
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Generate one with: openssl rand -hex 32
# If empty, a random secret is generated at startup and sessions end on restart.
SESSION_SECRET=

# HTTP port inside the container
PORT=3000

# Set to true when the dashboard is served via HTTPS (e.g. behind a reverse proxy)
COOKIE_SECURE=false

# Development only: seed simulated printers (host "mock") when no printers are configured
MOCK_PRINTERS=0
